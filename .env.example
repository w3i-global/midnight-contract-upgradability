# Midnight contract upgradability example
# Copy to `.env` and fill in real values before running deploy/update/rotation.

# Network and wallet
MN_UPGRADE_NETWORK=preprod
MN_UPGRADE_WALLET_MNEMONIC="replace with funded BIP-39 mnemonic"

# Existing maintenance authority signing key.
# Required for `npm run inspect`, `npm run update:v2`, and `npm run rotate:authority`.
# Optional for `npm run deploy:v1`; if omitted there, the script samples a fresh key and prints it once.
MN_UPGRADE_SIGNING_KEY=

# Replacement authority signing key for `npm run rotate:authority`.
# If omitted, the script samples a fresh key and prints it once.
MN_UPGRADE_NEW_SIGNING_KEY=

# Contract version view to use when joining.
# Use `v1` before the verifier-key update, then switch to `v2` after `npm run update:v2` succeeds.
MN_UPGRADE_CONTRACT_VERSION=v1

# Set after deployment, or leave blank if `data/latest-deployment.json` should be used.
MN_UPGRADE_CONTRACT_ADDRESS=

# Constructor args used by `npm run deploy:v1`
MN_UPGRADE_INITIAL_COUNTER=0
MN_UPGRADE_INITIAL_STEP=1

# Optional endpoint overrides
MN_UPGRADE_INDEXER=https://indexer.preprod.midnight.network/api/v3/graphql
MN_UPGRADE_INDEXER_WS=wss://indexer.preprod.midnight.network/api/v3/graphql/ws
MN_UPGRADE_NODE=https://rpc.preprod.midnight.network
MN_UPGRADE_NODE_WS=wss://rpc.preprod.midnight.network
MN_UPGRADE_PROOF_SERVER=https://lace-proof-pub.preprod.midnight.network

# Optional private state store override
MN_UPGRADE_PRIVATE_STATE_STORE=

# Typical workflow:
# 1. `npm run deploy:v1`
# 2. copy the printed maintenance signing key into MN_UPGRADE_SIGNING_KEY
# 3. set MN_UPGRADE_CONTRACT_ADDRESS from deploy output or data/latest-deployment.json
# 4. `npm run inspect`
# 5. `npm run update:v2`
# 6. set MN_UPGRADE_CONTRACT_VERSION=v2
# 7. `npm run rotate:authority`
