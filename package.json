{
  "name": "contract-upgradability",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Midnight contract maintenance authority and verifier-key update harness",
  "scripts": {
    "compile:v1": "compact compile contracts/upgradable-counter-v1.compact contracts/managed/upgradable-counter-v1",
    "compile:v1:skip-zk": "compact compile --skip-zk contracts/upgradable-counter-v1.compact contracts/managed/upgradable-counter-v1",
    "compile:v2": "compact compile contracts/upgradable-counter-v2.compact contracts/managed/upgradable-counter-v2",
    "compile:v2:skip-zk": "compact compile --skip-zk contracts/upgradable-counter-v2.compact contracts/managed/upgradable-counter-v2",
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "deploy:v1": "npm run build && node dist/deploy-v1.js",
    "inspect": "npm run build && node dist/inspect-deployment.js",
    "update:v2": "npm run build && node dist/update-to-v2.js",
    "rotate:authority": "npm run build && node dist/rotate-authority.js"
  },
  "dependencies": {
    "@midnight-ntwrk/compact-js": "2.4.0",
    "@midnight-ntwrk/compact-runtime": "0.14.0",
    "@midnight-ntwrk/ledger-v7": "7.0.0",
    "@midnight-ntwrk/midnight-js-contracts": "3.1.0",
    "@midnight-ntwrk/midnight-js-http-client-proof-provider": "3.1.0",
    "@midnight-ntwrk/midnight-js-indexer-public-data-provider": "3.1.0",
    "@midnight-ntwrk/midnight-js-level-private-state-provider": "3.1.0",
    "@midnight-ntwrk/midnight-js-network-id": "3.1.0",
    "@midnight-ntwrk/midnight-js-node-zk-config-provider": "3.1.0",
    "@midnight-ntwrk/midnight-js-types": "3.1.0",
    "@midnight-ntwrk/wallet-sdk-dust-wallet": "1.0.0",
    "@midnight-ntwrk/wallet-sdk-facade": "1.0.0",
    "@midnight-ntwrk/wallet-sdk-hd": "3.0.0",
    "@midnight-ntwrk/wallet-sdk-unshielded-wallet": "1.0.0",
    "@midnight-ntwrk/wallet-sdk-shielded": "1.0.0",
    "@scure/bip39": "2.0.1",
    "dotenv": "16.4.5",
    "rxjs": "7.8.2",
    "ws": "8.18.2"
  },
  "devDependencies": {
    "@types/node": "^24.4.0",
    "@types/ws": "^8.18.1",
    "typescript": "^5.9.2"
  },
  "engines": {
    "node": ">=22.0.0"
  }
}
